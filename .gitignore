# ===================================
# Important: Never ignore these!
# ===================================
# Keep all meta files in Assets
!/[Aa]ssets/**/*.meta
# Keep project settings
!/[Pp]rojectSettings/
# Keep packages manifest
!/[Pp]ackages/
